+    def test_the_seed_must_run_before_the_respawn_sweep_sees_it(
+        self,
+    ) -> None:
+        """F8 (pf-adversary, this round): a mutant moving the two-line seed
+        statement to the END of ``_sync_combat_scene_state`` survived 6/6
+        on this file, because every test above syncs a session on its OWN
+        boot scene -- ``__init__`` seeds ``mob_combat_scene_folder`` to
+        match it, so ``if folder != self.mob_combat_scene_folder:`` (where
+        ``mob_respawn.sweep_the_session_register`` lives) is false on the
+        very first evaluation and never runs.  Nothing between the seed's
+        real position and the end of the method ever reads what it wrote,
+        so the mutant was invisible to every assertion above: the seed
+        still runs once per sync either way, and by the time anything
+        checks ``is_dead``/HP the late seed has already caught up.
+
+        Forcing the branch open (no real scene change; scene identity is
+        not this test's subject) makes the ONE place the order is load-
+        bearing observable: MEASURED (both orders run against the SAME
+        real grave, only this file's own explore script diffed) -- the
+        seed-first order feeds the newly-buried grave into THIS call's
+        ``mob_respawn.sweep_the_session_register``, which prints a
+        ``MOB_RESPAWN`` line naming it as freshly dated; the seed-last
+        order hands that same sweep a virgin register, the grave is
+        invisible to it, the sweep has nothing to report and prints
+        nothing, and the world book's own respawn timer for that mob is
+        never consulted on this dispatch at all -- silently, since the
+        late seed still lands the grave in the register a moment later
+        and every register/ledger assertion in this file would pass
+        anyway.
+        """
+        first = self._session("seed-order-a")
+        self._kill_the_victim(first)
+
+        relogged = self._session("seed-order-b")
+        # Force the scene-change branch open on the very next sync without
+        # moving anywhere: `_sync` must already have seeded the register
+        # BEFORE this runs the branch's own respawn sweep.
+        relogged.mob_combat_scene_folder = None
+        console = io.StringIO()
+        with contextlib.redirect_stdout(console):
+            relogged._sync_combat_scene_state()
+
+        self.assertIn(
+            "MOB_RESPAWN", console.getvalue(),
+            "the scene-change branch's own respawn sweep printed nothing"
+            " for a grave the world book already held when this sync"
+            " began -- the seed ran AFTER the sweep instead of before it",
+        )
+        self.assertTrue(
+            relogged.mob_death_register.is_dead(
+                self.victim.actor_identity, self.folder),
+            "the grave must still land even when this assertion alone"
